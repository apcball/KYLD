<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Define Paper Format -->
    <record id="paperformat_purchase_order" model="report.paperformat">
        <field name="name">Purchase Order A4</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">4</field>
        <field name="margin_right">4</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">72</field>
    </record>

    <!-- Report Template -->
    <template id="report_purchaseorder_document_custom">
        <t t-name="buz_po_portal.report_purchaseorder_document_custom">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                       <div class="page">
    
                            <style>
                                @font-face {
                                    font-family: 'Sarabun';
                                    src: url('/buz_po_portal/static/fonts/Sarabun-Bold.ttf') format('truetype');
                                    font-weight: bold;
                                    font-style: normal;
                                }
                                @page {
                                    margin-top: 0mm;
                                    margin-bottom: 10mm;
                                    margin-left: 10mm;
                                    margin-right: 10mm;
                                }
                                
                                body, .page, .row {
                                    margin-top: 0 !important;
                                    padding-top: 0 !important;
                                }
                                
                                html, body, page, table, th, td, div, p, span, h1, h2, h3, h4, h5, h6 {
                                    font-family: 'Sarabun', sans-serif !important;
                                    font-size: 18px;
                                }
                                
                                .table {
                                    border-collapse: collapse !important;
                                    width: 100%;
                                }
                                
                                .table td,
                                .table th {
                                    border-width: 0.5px !important;
                                    border-style: solid !important;
                                    border-color: #000 !important;
                                    padding:  1px 1px;
                                }
    
                                .order-line-table th,
                                .order-line-table td {
                                    padding-top: 10px !important;
                                    padding-bottom: 10px !important;
                                   line-height: 1.1 !important;
                                }
                                
                                .no-inner-borders td,
                                .no-inner-borders th {
                                    border: none !important;
                                }
                                
                                .table-bordered,
                                .table-bordered td,
                                .table-bordered th {
                                    border: none !important;
                                }
    
                                .page {
                                    page-break-after: always;
                                }
                                .page:last-child {
                                    page-break-after: auto;
                                }
    
                                .page-break {
                                    page-break-after: always;
                                  }
    
                                .vendor-info, .delivery-info {
                                    font-size: 14px;
                                }
                    
                                .line.name{
                                    max-width: 100px;
                                    white-space: nowrap;
                                    overflow: hidden;
                                    text-overflow: ellipsis;
                                }
                                .footer-fixed {
                                    position: absolute;
                                    bottom: 0;
                                    width: 100%;
                                    font-size: 16px;
                                    display: flex;
                                    justify-content: space-between;
                                  }
                                  @page {
                                    margin: 10mm 10mm 20mm 10mm; /* ซ้าย ขวา บน ล่าง */
                                    @bottom-left {
                                        content: "อนุมัติใช้วันที่ 14/09/2563";
                                        font-size: 14px;
                                    }
                                    @bottom-right {
                                        content: "FM-PUR-08.REV.01";
                                        font-size: 14px;
                                    }
                                    }
                                    
                           
                     
                            </style>
     
               <!-- Order Lines - Refactored: Loop only once, paginated in one loop -->
        <t t-set="line_count" t-value="len(o.order_line)"/>
        <t t-set="lines_per_page" t-value="10"/>
        <t t-set="total_pages" t-value="int((line_count + lines_per_page - 1) / lines_per_page)"/>
        <t t-foreach="range(total_pages)" t-as="page_num">
            <div t-attf-style="#{page_num &gt; 0 and 'page-break-before: always;' or ''}">
    
                           
    
                <!-- ส่วนหัว (Header) -->
               <div class="row mb-2">
    <div class="col-12 text-center">
        <div style="font-size: 20px; line-height: 1.6;">
            <strong><span t-field="o.company_id.name" style="font-size: 28px !important;"/></strong><br/>
            <strong>
                <span t-if="o.company_id.street"><span t-field="o.company_id.street"/> </span>
                <span t-if="o.company_id.street2"><span t-field="o.company_id.street2"/> </span>
                <span t-if="o.company_id.city"><span t-field="o.company_id.city"/> </span>
                <span t-if="o.company_id.state_id"><span t-field="o.company_id.state_id.name"/> </span>
                <span t-if="o.company_id.zip"><span t-field="o.company_id.zip"/> </span>
            </strong><br/>
            <strong>
                <t t-if="o.company_id.phone">โทร. <span t-field="o.company_id.phone"/> </t>
                <t t-if="o.company_id.vat">เลขประจำตัวผู้เสียภาษีอากร <span t-field="o.company_id.vat"/></t>
            </strong>
        </div>
    </div>
</div>

               <!-- Document Title -->
               <div class="row mb-2">
                <div class="col-12 text-center">
                    <h2 style="margin: 0; padding: 0; font-weight: bold; font-size: 26px; margin-top: 10px;">ใบสั่งซื้อ / PURCHASE ORDER</h2>
                </div>
            </div>


            <table style="width: 100%; border-collapse: collapse; font-size: 16px;">
                <tr>
                  <!-- กรอบซ้าย -->
                  <td style="width: 50%; border: 1px solid #000; vertical-align: top; padding: 5px;">
                    <div>
                      <p><strong>ชื่อผู้ขาย:</strong> <span t-field="o.partner_id.name"/></p>
                      <p>
                        <strong style="display: inline-block; width: 25%;">ที่อยู่/ADDRESS:</strong>
                        <span t-field="o.partner_id.street"/>
                        <span t-if="o.partner_id.street2" t-field="o.partner_id.street2"/>
                        <span t-if="o.partner_id.city"> <t t-esc="o.partner_id.city"/></span>
                        <span t-if="o.partner_id.state_id"> <t t-esc="o.partner_id.state_id.name"/></span>
                        <span t-if="o.partner_id.zip"> <t t-esc="o.partner_id.zip"/></span>
                    
                      </p>
                      <table style="width: 100%;">
                        <tr>
                          <td style="width: 50%; border: none;"><strong>โทร:</strong> <span t-field="o.partner_id.phone"/></td>
                        </tr>
                      </table>
                    </div>
                  </td>

                  <!-- กรอบขวา -->
                  <td style="width: 50%; border: 1px solid #000; vertical-align: top; padding: 5px;">
                    <table style="width: 100%;">
                      <tr>
                        <td style="width: 50%; border: none;"><strong>เลขที่ใบสั่งซื้อ:</strong> <span t-field="o.name"/></td>
                        <td style="width: 50%; border: none;"><strong>วันที่ใบสั่งซื้อ:</strong> <span t-field="o.date_order" t-options='{"widget": "date"}'/></td>
                      </tr>
                    </table>
                    <p><strong>วันที่กำหนดส่ง:</strong> <span t-field="o.date_planned" t-options='{"widget": "date"}'/></p>
                    <p><strong>จำนวนวันเครดิต:</strong> <span t-esc="o.payment_term_id.name or '-'"/></p>
                    <p><strong>ชื่อผู้ติดต่อ:</strong> <span t-field="o.employee_contact_id.name"/></p>
                  </td>
                </tr>
              </table>

            <!-- Order Line -->
    <div style="height:16px;"></div>
        <table class="table table-sm mt-4 order-line-table"
          style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-bottom: 0px; margin-top: -80px;">
           <thead>
               <tr>
                   <th style="width: 5%; text-align: center; border: 1px solid black; padding: 4px;">ลำดับ<br/><span style="font-size: 12px;">(No)</span></th>
                   <th style="width: 60%; text-align: center; border: 1px solid black; padding: 4px;">รายการ<br/><span style="font-size: 12px;">(Description)</span></th>
                   <th class="qty-col" style="width: 8.33%; text-align: center; border: 1px solid black; padding: 4px;">จำนวน<br/><span style="font-size: 12px;">(Qty)</span></th>
                   <th style="width: 8.33%; text-align: center; border: 1px solid black; padding: 4px;">หน่วย<br/><span style="font-size: 12px;">(Unit)</span></th>
                   <th style="width: 8.33%; text-align: center; border: 1px solid black; padding: 4px;">ราคา/หน่วย<br/><span style="font-size: 12px;">(Unit Price)</span></th>
                   <th style="width: 10%; text-align: center; border: 1px solid black; padding: 4px;">จำนวนเงิน<br/><span style="font-size: 12px;">(Amount)</span></th>
               </tr>
           </thead>
           <tbody>
               <t t-set="start_idx" t-value="page_num * lines_per_page"/>
               <t t-set="end_idx" t-value="min((page_num + 1) * lines_per_page, line_count)"/>
               <t t-set="current_line_number" t-value="start_idx + 1"/>
               <t t-foreach="enumerate(o.order_line[start_idx:end_idx])" t-as="line_tuple">
                   <tr style="font-size: 18px; height: 40px;">
                       <!-- ลำดับ -->
                       <td style="border: 1px solid black; text-align: center; vertical-align: middle;">
                           <span t-esc="current_line_number + line_tuple[0]"/>
                       </td>
                       <!-- รายการ (ชื่อสินค้า) -->
                       <td style="border: 1px solid black; vertical-align: top; padding: 5px; text-align: left;">
                           <span t-esc="line_tuple[1].name.replace('\n', ' ') if line_tuple[1].name else ''"/>
                       </td>
                       <!-- จำนวน -->
                    <td class="qty-col" style="border: 1px solid black; text-align: center; vertical-align: middle; padding: 0 2px; white-space: nowrap;">
                        <span t-esc="'%.2f' % line_tuple[1].product_uom_qty if line_tuple[1].product_uom_qty else '0'"/>
                    </td>
                       <!-- หน่วย -->
                       <td style="border: 1px solid black; text-align: center; vertical-align: middle;">
                           <span t-field="line_tuple[1].product_uom.name"/>
                       </td>
                       <!-- ราคา/หน่วย -->
                       <td style="text-align: right; border: 1px solid black; padding: 1px 2px;
                                 overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: middle; font-size: 16px;">
                          <span t-esc="'{:,.2f}'.format(line_tuple[1].price_unit)"/>
                      </td>
                       <!-- จำนวนเงิน -->
                       <td style="border: 1px solid black; text-align: right; vertical-align: middle; padding-right: 2px;">
                           <t t-set="subtotal" t-value="line_tuple[1].product_uom_qty * line_tuple[1].price_unit * (1 - (line_tuple[1].discount or 0.0)/100)"/>
                           <span t-esc="'{:,.2f}'.format(subtotal or 0.0)"/>
                       </td>
                   </tr>
               </t>
           </tbody>
       </table>
         
                  
                <t t-if="page_num != total_pages - 1">
                    <div style="position: relative; min-height: 25mm; padding-bottom: 80mm;">
                      <!-- เนื้อหาหน้านั้น ๆ เช่น ตาราง หรือข้อความอื่น ๆ -->
                  
                      <!-- Footer fixed bottom -->
                      <div style="
                        position: absolute;
                        bottom: 0; left: 0; width: 100%;
                        display: flex; justify-content: space-between;
                        font-size: 10px;
                        padding-left: 4mm; padding-right: 4mm;
                        line-height: 1.2;
                        page-break-inside: avoid;
                        ">
                       
                      </div>
                    </div>
                  </t>
                  
                  
          </div>
       </t>     
            
      <!-- กล่องรวม หมายเหตุ + ผลรวม -->
       <div style="display: flex; width: 100%; box-sizing: border-box; margin-bottom: 4px; margin-top: 10px; min-height: 174px; height: 174px;">
    
        <!-- ฝั่งซ้าย -->
        <div style="width: 60%; padding: 0 4px 0 0; box-sizing: border-box; height: 100%;">
            <table style="width: 100%; border-collapse: collapse; font-size: 12px; height: 100%;">
                <tr>
                    <td style="border: 1px solid black; padding: 0; height: 100%; vertical-align: top;">
                        <!-- แบ่งด้านในเป็น 2 ส่วน -->
                        <div style="height: 100%; display: flex; flex-direction: column;">
                            <!-- หมายเหตุ 80% -->
                            <div style="flex: 1; padding: 10px; box-sizing: border-box; border-bottom: 1px solid black; overflow: hidden;">
                                <strong>หมายเหตุ:</strong>
                                <span t-esc="o.notes or ''" style="display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"/>
                            </div>
                            <!-- จำนวนเงิน 20% -->
                            <div style="height: 35px; padding: 10px; box-sizing: border-box;">
                                <strong>จำนวนเงิน (ตัวอักษร):</strong>
                                <span t-esc="o.amount_total_text_th"/>
                            </div>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    
        <!-- ฝั่งขวา -->
        <div style="width: 40%; padding: 0 0 0 2px; box-sizing: border-box; height: 100%; display: flex; flex-direction: column;">
            <t t-set="amount_untaxed" t-value="o.amount_untaxed or 0.0"/>
            <t t-set="total_discount" t-value="sum([(line.product_qty * line.price_unit * (line.discount or 0.0)/100.0) for line in o.order_line])"/>
            <t t-set="amount_after_discount" t-value="(amount_untaxed or 0.0) - (total_discount or 0.0)"/>
            <t t-set="amount_tax" t-value="o.has_vat and o.amount_tax or 0.0"/>
            <t t-set="amount_total" t-value="(o.has_vat and amount_after_discount + amount_tax) or amount_after_discount"/>
    
            <table style="width: 100%; border-collapse: collapse; font-size: 20px; border: 1px solid #000; margin: 0; height: 100%;">
                <tr>
                    <td style="text-align: right; padding: 2px 4px; border: 1px solid #000;">ราคารวม/Total:</td>
                    <td style="text-align: right; padding: 2px 4px; border: 1px solid #000;">
                        <span t-esc="'{:,.2f}'.format(amount_untaxed)"/>
                    </td>
                </tr>
                <tr>
                    <td style="text-align: right; padding: 2px 4px; border: 1px solid #000;">ส่วนลด/Discount:</td>
                    <td style="text-align: right; padding: 2px 4px; border: 1px solid #000;">
                        <span t-esc="'{:,.2f}'.format(total_discount)"/>
                    </td>
                </tr>
                <tr>
                    <td style="text-align: right; padding: 2px 4px; border: 1px solid #000;">คงเหลือ/Remaining:</td>
                    <td style="text-align: right; padding: 2px 4px; border: 1px solid #000;">
                        <span t-esc="'{:,.2f}'.format(amount_after_discount)"/>
                    </td>
                </tr>
                <tr>
                    <td style="text-align: right; padding: 2px 4px; border: 1px solid #000;">ภาษีมูลค่าเพิ่ม 7%:</td>
                    <td style="text-align: right; padding: 2px 4px; border: 1px solid #000;">
                        <span t-esc="'{:,.2f}'.format(amount_tax)"/>
                    </td>
                </tr>
                <tr>
                    <td style="text-align: right; padding: 2px 4px; border: 1px solid #000;"><strong>จำนวนเงินรวมทั้งสิ้น:</strong></td>
                    <td style="text-align: right; padding: 2px 4px; border: 1px solid #000;"><strong>
                        <span t-esc="'{:,.2f}'.format(amount_total)"/>
                    </strong></td>
                </tr>
            </table>
        </div>
    </div>
                        
    
                            <!-- Signature Section -->
                            <div class="row mt-5" style="margin-top: 0px;">
                                <!-- Common styles for signature boxes -->
                                <style>
                                    .signature-box {
                                        font-size: 12px;
                                        text-align: center;
                                        width: 100%;
                                    }
                                    .signature-content {
                                        height: 120px;
                                        display: flex;
                                        flex-direction: column;
                                        justify-content: flex-end;
                                        align-items: center;
                                        margin-bottom: 10px;
                                    }
                                    .signature-line {
                                        border-top: 1px solid #000;
                                        margin: 0 auto;
                                        width: 80%;
                                        padding-top: 5px;
                                    }
                                    .signature-title {
                                        margin: 5px 0;
                                        font-weight: normal;
                                    }
                                    .signature-date {
                                        margin: 5px 0;
                                    }
                                    .signature-image {
                                        width: 100px;
                                        height: 60px;
                                        object-fit: contain;
                                        margin-bottom: 5px;
                                    }
                                    .signature-name {
                                        margin: 0;
                                        line-height: 1.5;
                                    }
                                </style>
                                <!-- ผู้จัดทำ -->
                                <div class="row" style="margin-top: 100px; display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between;">
                                    <!-- ส่วนที่ 1: ผู้จัดทำ -->
                                    <div class="col" style="width: 33%; box-sizing: border-box; padding-right: 10px; display: flex; flex-direction: column; justify-content: flex-start;">
                                        <div style="text-align: center; font-size: 18px;">
                                            <div style="height:24px;"></div>
                                            <t t-if="o.prepared_signature">
                                                <img t-att-src="image_data_uri(o.prepared_signature)" style="height: 60px; max-width: 100%; display: block; margin: 0 auto;"/>
                                                <div style="border-bottom: 1px solid black; width: 80%; margin: 0 auto;"></div>
                                                <div>
                                                    (<span t-field="o.create_uid.name" style="display:inline; margin:0; padding:0;"/>)
                                                </div>
                                                <div> ผู้จัดทำ </div>
                                                <div>
                                                    วันที่ <span t-field="o.prepared_date" t-options='{"widget": "date"}'/>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <!-- Empty space for image alignment -->
                                                <div style="height: 60px;"></div>
                                                <div style="border-bottom: 1px solid black; width: 80%; margin: 0 auto;"></div>
                                                <div>
                                                    (<span t-esc="o.create_uid.name or ''"/>)
                                                </div>
                                                <div>
                                                    ผู้จัดทำ
                                                </div>
                                                <div>
                                                    วันที่...............................
                                                </div>
                                            </t>
                                        </div>
                                    </div>

                                    <!-- ส่วนที่ 2: ผู้ตรวจสอบ -->
                                    <div class="col" style="width: 33%; box-sizing: border-box; padding-right: 10px; display: flex; flex-direction: column; justify-content: flex-start;">
                                        <div style="text-align: center; font-size: 18px;">
                                            <div style="height:24px;"></div>
                                            <t t-if="o.reviewed_signature">
                                                <img t-att-src="image_data_uri(o.reviewed_signature)" style="height: 60px; max-width: 100%; display: block; margin: 0 auto;"/>
                                                <div style="border-bottom: 1px solid black; width: 80%; margin: 0 auto;"></div>
                                                <div>
                                                    (<span t-field="o.reviewer_id.name" style="display:inline; margin:0; padding:0;"/>)
                                                </div>
                                                <div> ผู้ตรวจสอบ </div>
                                                <div>
                                                    วันที่ <span t-field="o.reviewed_date" t-options='{"widget": "date"}'/>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <!-- Empty space for image alignment -->
                                                <div style="height: 60px;"></div>
                                                <div style="border-bottom: 1px solid black; width: 80%; margin: 0 auto;"></div>
                                                <div>
                                                    (....................................)
                                                </div>
                                                <div>
                                                    ผู้ตรวจสอบ
                                                </div>
                                                <div>
                                                    วันที่...............................
                                                </div>
                                            </t>
                                        </div>
                                    </div>

                                    <!-- ส่วนที่ 3: ผู้อนุมัติ -->
                                    <div class="col" style="width: 33%; box-sizing: border-box; display: flex; flex-direction: column; justify-content: flex-start;">
                                        <div style="text-align: center; font-size: 18px;">
                                            <div style="height:24px;"></div>
                                            <t t-if="o.approval_signature">
                                                <img t-att-src="image_data_uri(o.approval_signature)" style="height: 60px; max-width: 100%; display: block; margin: 0 auto;"/>
                                                <div style="border-bottom: 1px solid black; width: 80%; margin: 0 auto;"></div>
                                                <div>
                                                    (<span t-field="o.approver_id.name" style="display:inline; margin:0; padding:0;"/>)
                                                </div>
                                                <div> ผู้อนุมัติ </div>
                                                <div>
                                                    วันที่ <span t-field="o.approval_date" t-options='{"widget": "date"}'/>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <!-- Empty space for image alignment -->
                                                <div style="height: 60px;"></div>
                                                <div style="border-bottom: 1px solid black; width: 80%; margin: 0 auto;"></div>
                                                <div>
                                                    <!-- Check if PO exceeds approval limit -->
                                                    <t t-if="o.amount_total &gt; o.company_id.po_approver_limit and o.company_id.po_approver_above_limit_id">
                                                        (<span t-esc="o.company_id.po_approver_above_limit_id.name" style="display:inline; margin:0; padding:0;"/>)
                                                    </t>
                                                    <t t-elif="o.company_id.po_approver_ids">
                                                        (<span t-esc="', '.join(o.company_id.po_approver_ids.mapped('name'))" style="display:inline; margin:0; padding:0;"/>)
                                                    </t>
                                                    <t t-else="">
                                                        (....................................)
                                                    </t>
                                                </div>
                                                <div>
                                                    ผู้อนุมัติ
                                                </div>
                                                <div>
                                                    วันที่...............................
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            
                            <!-- Footer Section -->
                            <div class="row mt-3" style="font-size: 14px; margin-left:0; margin-right:0; margin-top: 20;">
                                <div class="col-12" style="padding-left:0; padding-right:0;">
                                    <div style="border: 1px solid #000; padding: 4px; margin:0;">
                                        <div class="row" style="margin-left: 0; margin-right: 0;">
                                            <div class="col-6" style="padding-left: 2px; padding-right: 2px;">
                                                <strong style="font-size: 14px;">เงื่อนไขและการส่งมอบ</strong>
                                                <ol style="font-size: 14px; margin-bottom: 0px; padding-left: 14px;">
                                                    <li>สินค้าที่ส่งมอบต้องให้มีคุณภาพ ขนาด ปริมาณ และจัดส่งตามกำหนด</li>
