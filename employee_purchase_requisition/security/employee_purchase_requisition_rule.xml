<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record rule: Multi-company access for employee.purchase.requisition -->
    <record id="employee_purchase_requisition_multi_company_rule" model="ir.rule">
        <field name="name">employee.purchase.requisition multi-company</field>
        <field name="model_id" ref="model_employee_purchase_requisition"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('employee_purchase_requisition.employee_requisition_user')), (4, ref('employee_purchase_requisition.employee_requisition_manager')), (4, ref('employee_purchase_requisition.employee_requisition_head'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>
