<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override the existing Location multi-company rule -->
    <record id="stock.stock_location_comp_rule" model="ir.rule">
        <field name="name">Location multi-company</field>
        <field name="model_id" ref="stock.model_stock_location"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
        <field name="active" eval="False"/>
    </record>
    
    <!-- Create a new permissive rule for stock locations -->
    <record id="stock_location_permissive_rule" model="ir.rule">
        <field name="name">Stock Location Permissive Access</field>
        <field name="model_id" ref="stock.model_stock_location"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>
