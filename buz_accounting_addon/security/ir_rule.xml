<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Multi-company rules (Non-global, combined with OR for admins) -->
        <record id="account_receipt_comp_rule" model="ir.rule">
            <field name="name">Account Receipt multi-company</field>
            <field name="model_id" ref="model_account_receipt"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="account_receipt_line_comp_rule" model="ir.rule">
