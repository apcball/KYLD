<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="biz_weekly_budget.WeeklyBudgetDashboard" owl="1">
        <div class="o_weekly_budget_dashboard p-4 h-100 overflow-auto">
            <!-- Header + filters -->
            <div class="o_bd_header d-flex flex-wrap align-items-center justify-content-between mb-4">
                <div class="d-flex align-items-center mb-2">
                    <span class="o_bd_title_icon"><i class="fa fa-line-chart"/></span>
                    <div class="ms-3 ml-3">
                        <h2 class="o_bd_title mb-0">Cashflow Forecast Dashboard</h2>
                        <div class="text-muted">ภาพรวมกระแสเงินสด / การใช้จ่าย และการคาดการณ์</div>
                    </div>
                </div>
                <div class="o_bd_filters d-flex flex-wrap align-items-end">
                    <div class="o_bd_filter">
                        <label>By Company</label>
                        <select class="form-select form-control" t-on-change="onCompanyChange">
                            <option value="all" t-att-selected="isSelected('selectedCompanyId', 'all')">All Companies</option>
                            <t t-foreach="state.companies" t-as="company" t-key="company.id">
                                <option t-att-value="company.id" t-esc="company.name"
                                        t-att-selected="isSelected('selectedCompanyId', company.id)"/>
                            </t>
                        </select>
                    </div>
                    <div class="o_bd_filter">
                        <label>ปีงบประมาณ</label>
                        <select class="form-select form-control" t-on-change="onYearChange">
                            <option value="all" t-att-selected="isSelected('selectedYear', 'all')">All Years</option>
                            <t t-foreach="state.years" t-as="year" t-key="year">
                                <option t-att-value="year" t-esc="year"
                                        t-att-selected="isSelected('selectedYear', year)"/>
                            </t>
                        </select>
                    </div>
                    <div class="o_bd_filter">
                        <label>เดือน</label>
                        <select class="form-select form-control" t-on-change="onMonthChange">
                            <t t-foreach="state.months" t-as="month" t-key="month.id">
                                <option t-att-value="month.id" t-esc="month.name"
                                        t-att-selected="isSelected('selectedMonth', month.id)"/>
                            </t>
                        </select>
                    </div>
                    <div class="o_bd_filter">
                        <label>งบประมาณ</label>
                        <select class="form-select form-control" t-on-change="onPlanChange">
                            <option value="all" t-att-selected="isSelected('selectedPlanId', 'all')">All Monthly Plans</option>
                            <t t-foreach="state.plans" t-as="plan" t-key="plan.id">
                                <option t-att-value="plan.id" t-esc="plan.name"
                                        t-att-selected="isSelected('selectedPlanId', plan.id)"/>
                            </t>
                        </select>
                    </div>
                    <div class="o_bd_updated">
                        <div class="text-muted small">อัปเดตล่าสุด</div>
                        <div class="fw-bold font-weight-bold" t-esc="state.updatedAt"/>
                    </div>
                    <button type="button" class="btn btn-primary o_bd_refresh" t-on-click="onRefresh"
                            t-att-disabled="state.refreshing">
                        <i t-attf-class="fa fa-refresh #{state.refreshing ? 'fa-spin' : ''}"/> Refresh
                    </button>
                </div>
            </div>

            <!-- KPI cards -->
            <div class="o_bd_kpis mb-4">
                <t t-foreach="kpis" t-as="kpi" t-key="kpi.key">
                    <div t-attf-class="o_bd_kpi o_bd_kpi_#{kpi.key}">
                        <div class="d-flex align-items-center">
                            <span class="o_bd_kpi_icon"><i t-attf-class="fa #{kpi.icon}"/></span>
                            <div class="ms-3 ml-3">
                                <div class="o_bd_kpi_label" t-esc="kpi.label"/>
                                <div class="o_bd_kpi_value" t-esc="kpi.value"/>
                            </div>
                        </div>
                        <div class="o_bd_kpi_sub" t-esc="kpi.sub"/>
                        <div class="o_bd_bar" t-if="kpi.pct !== null">
                            <div class="o_bd_bar_fill" t-attf-style="width: #{kpi.barWidth}%"/>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Row 1 -->
            <div class="row mb-4">
                <div class="col-lg-6 mb-3">
                    <div class="o_bd_panel">
                        <div class="o_bd_panel_title">Department Overview</div>
                        <div class="text-muted small mb-2">สรุปการใช้จ่ายตามแผนก (บาท)</div>
                        <div class="o_bd_chart"><canvas t-ref="chart"/></div>
                        <div t-if="!state.departments.length" class="o_bd_empty">No data</div>
                    </div>
                </div>
                <div class="col-lg-6 mb-3">
                    <div class="o_bd_panel">
                        <div class="o_bd_panel_title">Weekly Trend</div>
                        <div class="text-muted small mb-2">แนวโน้มการใช้จ่ายรายสัปดาห์ (limit ต่อสัปดาห์คิดตามสัดส่วนจำนวนวัน)</div>
                        <div class="o_bd_chart"><canvas t-ref="lineChart"/></div>
                        <div t-if="!state.weekly.length" class="o_bd_empty">No data</div>
                    </div>
                </div>
            </div>

            <!-- Row 2 -->
            <div class="row">
                <div class="col-12 mb-3">
                    <div class="o_bd_panel">
                        <div class="o_bd_panel_title">Budget Utilization</div>
                        <div class="text-muted small mb-2">สัดส่วนการใช้งบประมาณ</div>
                        <div class="row">
                            <div class="col-12">
                                <table class="table table-sm o_bd_legend mb-0">
                                    <tbody>
                                        <t t-foreach="legend" t-as="row" t-key="row.label">
                                            <tr>
                                                <td><span class="o_bd_dot" t-attf-style="background: #{row.color}"/></td>
                                                <td t-esc="row.label"/>
                                                <td class="text-end text-right" t-esc="row.amount"/>
                                                <td class="text-end text-right text-muted" t-esc="row.pct"/>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actual Payment: one chart per company -->
            <div class="o_bd_panel mb-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="o_bd_panel_title">Actual Payment <span class="text-muted fw-normal">(ยอดการจ่ายจริงรายเดือน)</span></div>
                        <div class="text-muted small mb-3">ยอดจ่ายจริง 12 เดือนล่าสุด แยกตามบริษัท · คลิกที่เดือนเพื่อ export Excel</div>
                    </div>
                </div>
                <div class="o_bd_payment_grid" t-ref="paymentGrid"/>
                <div t-if="!state.payments.length" class="text-muted text-center py-4">No data</div>
            </div>
        </div>
    </t>
</templates>
