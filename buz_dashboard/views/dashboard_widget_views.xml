<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_buz_dashboard_widget_list" model="ir.ui.view">
            <field name="name">buz.dashboard.widget.list</field>
            <field name="model">buz.dashboard.widget</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="dashboard_id"/>
                    <field name="widget_type"/>
                    <field name="endpoint"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_buz_dashboard_widget_form" model="ir.ui.view">
            <field name="name">buz.dashboard.widget.form</field>
            <field name="model">buz.dashboard.widget</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="dashboard_id"/>
                            <field name="widget_type"/>
                            <field name="endpoint"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Configuration">
                            <field name="config_json" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_buz_dashboard_widget" model="ir.actions.act_window">
            <field name="name">Dashboard Widgets</field>
            <field name="res_model">buz.dashboard.widget</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
