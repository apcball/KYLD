<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_buz_dashboard_list" model="ir.ui.view">
            <field name="name">buz.dashboard.list</field>
            <field name="model">buz.dashboard</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="company_id"/>
                    <field name="widget_count"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_buz_dashboard_form" model="ir.ui.view">
            <field name="name">buz.dashboard.form</field>
            <field name="model">buz.dashboard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="company_id"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="description"/>
                        </group>
                        <notebook>
                            <page string="Widgets">
                                <field name="widget_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="widget_type"/>
                                        <field name="endpoint"/>
                                        <field name="active"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_buz_dashboard" model="ir.actions.act_window">
            <field name="name">Dashboards</field>
            <field name="res_model">buz.dashboard</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
