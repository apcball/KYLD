<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trade Channel Tree View -->
    <record id="view_marketplace_trade_channel_tree" model="ir.ui.view">
        <field name="name">marketplace.trade.channel.tree</field>
        <field name="model">marketplace.trade.channel</field>
        <field name="arch" type="xml">
            <tree string="Trade Channels">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Trade Channel Form View -->
    <record id="view_marketplace_trade_channel_form" model="ir.ui.view">
        <field name="name">marketplace.trade.channel.form</field>
        <field name="model">marketplace.trade.channel</field>
        <field name="arch" type="xml">
            <form string="Trade Channel">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Line Shopping"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. line_shopping"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Trade Channel Action -->
    <record id="action_marketplace_trade_channel" model="ir.actions.act_window">
        <field name="name">Trade Channels</field>
        <field name="res_model">marketplace.trade.channel</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Trade Channel
            </p>
            <p>
                Trade Channels represent the different marketplaces or platforms where you sell products (e.g. Shopee, Lazada, TikTok).
            </p>
        </field>
    </record>

    <!-- Menu Item in Configuration -->
    <menuitem id="menu_marketplace_trade_channel"
              name="Trade Channels"
              parent="menu_settlement_configuration"
              action="action_marketplace_trade_channel"
              sequence="20"/>
</odoo>
