<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_boq_material_requisition_wizard_form" model="ir.ui.view">
        <field name="name">boq.material.requisition.wizard.form</field>
        <field name="model">boq.material.requisition.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Material Requisition from BOQ">
                <field name="currency_id" invisible="1"/>
                <sheet>
                    <group>
                        <group>
                            <field name="boq_id" readonly="1"/>
                            <field name="project_id"/>
                            <field name="job_order_id" invisible="not job_order_id"/>
                            <field name="job_cost_sheet_id" invisible="not job_cost_sheet_id"/>
                        </group>
                        <group>
                            <field name="purpose"/>
                            <field name="required_date"/>
                            <field name="priority"/>
                        </group>
                    </group>
                    <p class="text-muted">Select the items and enter the quantities you need. Only selected items will be included in the draft requisition.</p>
                    <field name="line_ids">
                        <tree editable="bottom" create="0" delete="0" limit="80"
                              decoration-warning="selected and has_warning">
                            <field name="selected"/>
                            <field name="boq_line_id" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="has_warning" column_invisible="1"/>
                            <field name="product_id" readonly="1" force_save="1"/>
                            <field name="description" readonly="1" force_save="1"/>
                            <field name="category_id" readonly="1" optional="hide"/>
                            <field name="uom_id" readonly="1" force_save="1"/>
                            <field name="boq_quantity" force_save="1"/>
                            <field name="requisitioned_quantity" force_save="1"/>
                            <field name="remaining_quantity" force_save="1"/>
                            <field name="requested_quantity" readonly="not selected" force_save="1"
                                   decoration-danger="selected and requested_quantity &lt;= 0"/>
                            <field name="quantity_status" widget="badge" optional="hide"/>
                            <field name="estimated_cost" optional="hide" readonly="not selected" force_save="1"/>
                            <field name="total_cost" widget="monetary" optional="hide"/>
                        </tree>
                    </field>
                    <group>
                        <field name="total_lines_count"/>
                        <field name="selected_total_cost" widget="monetary"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_requisition" string="Create Draft Requisition"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_boq_material_requisition_wizard" model="ir.actions.act_window">
        <field name="name">Create Material Requisition</field>
        <field name="res_model">boq.material.requisition.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_boq_id': active_id}</field>
    </record>
</odoo>
