<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="material_requisition_view_form_inherit_buz_auto_analytic" model="ir.ui.view">
        <field name="name">material.requisition.view.form.inherit.buz.auto.analytic</field>
        <field name="model">material.requisition</field>
        <field name="inherit_id" ref="job_costing_management.view_material_requisition_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='required_date']" position="after">
                <field name="analytic_auto_sync" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
