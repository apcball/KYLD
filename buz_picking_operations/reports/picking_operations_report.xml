<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Paper Format for Picking Operations Reports -->
        <record id="paperformat_picking_operations" model="report.paperformat">
            <field name="name">Picking Operations A4</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">6</field>
            <field name="margin_right">6</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <!-- Report Template -->
        <template id="report_picking_operations_custom">
            <t t-call="web.html_container">
                <t t-foreach="docs.sudo()" t-as="o">
                    <t t-call="web.basic_layout">
                        <style>
                            @font-face {
                                font-family: 'Sarabun';
                                src: url('/buz_picking_operations/static/fonts/Sarabun-Bold.ttf') format('truetype');
                            }
                            .page {
                                font-family: 'Sarabun', sans-serif;
                                font-size: 20px;
                                color: #000000;
                            }
                            .info-box {
                                background-color: #f8f9fa !important;
                                color: black !important;
                                font-size: 20px !important;
                                border: 1px solid #000 !important;
                                padding: 10px;
                            }
                            .table {
                                width: 100%;
                                color: black !important;
                                font-size: 20px !important;
                                border-collapse: collapse !important;
                                table-layout: fixed !important;
                            }
                            .table th, .table td {
                                border: 1px solid #000 !important;
                                padding: 4px 6px !important;
                                height: 40px !important;
                                vertical-align: middle !important;
                                overflow: hidden !important;
                                white-space: nowrap !important;
                                text-overflow: ellipsis !important;
                            }
                            .table thead {
                                display: table-header-group !important;
                            }
                            .table tbody {
                                display: table-row-group !important;
                            }
                            .table tr {
                                page-break-inside: avoid !important;
                                page-break-after: auto;
                            }
                            .table thead th {
                                background-color: #f8f9fa !important;
                                font-weight: bold !important;
                                border-bottom: 2px solid #000 !important;
                                overflow: hidden !important;
                                white-space: nowrap !important;
                                text-overflow: ellipsis !important;
                            }
                            .table-container {
                                margin-top: 20px;
                                padding: 0;
                            }
                            .empty-row td {
                                border: 1px solid #000 !important;
                            }
                            h3, strong, p, span {
                                color: black !important;
                            }
                            .company-header, .company-info {
                                color: black !important;
                            }
                            .signature-line {
                                border-top: 1px solid black !important;
                                color: black !important;
                            }
                        </style>

                        <!-- Calculate Pages and Totals -->
                        <t t-set="total_qty" t-value="sum(o.move_ids.mapped('product_uom_qty'))"/>
                        <t t-set="total_items" t-value="len(o.move_ids)"/>
                        <t t-set="num_pages" t-value="1 if len(o.move_ids) == 0 else ((len(o.move_ids) - 1) // 15) + 1"/>

                        <t t-foreach="range(num_pages)" t-as="page_index">
                            <div class="page" t-attf-style="{{ 'page-break-after: always;' if page_index &lt; num_pages - 1 else '' }}">
                                <!-- Company Info Section -->
                                <div class="row mb-2">
                                    <div class="col-8">
                                        <div class="company-header mb-1" style="font-size: 20px; font-weight: bold;">
                                            <span t-field="o.company_id.name"/>
                                        </div>
                                        <div class="company-info" style="font-size: 18px;">
                                            <span t-if="o.company_id.street" t-field="o.company_id.street"/>
                                            <span t-if="o.company_id.street2" t-esc="' ' + o.company_id.street2"/>
                                        </div>
                                        <div class="company-info" style="font-size: 18px;">
                                            <span t-if="o.company_id.city" t-field="o.company_id.city"/>
                                            <span t-if="o.company_id.state_id" t-esc="' ' + o.company_id.state_id.name"/>
                                            <span t-if="o.company_id.zip" t-esc="' ' + o.company_id.zip"/>
                                        </div>
                                        <div class="company-info" style="font-size: 18px;">
                                            <t t-if="o.company_id.phone">Tel: <span t-field="o.company_id.phone"/></t>
                                            <t t-if="o.company_id.vat"> Tax ID: <span t-field="o.company_id.vat"/></t>
                                        </div>
                                    </div>
                                    <div class="col-4 text-end">
                                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" 
                                            style="max-width: 150px; height: auto;" alt="Company Logo"/>
                                    </div>
                                </div>

                                <!-- Header -->
                                <div class="mt-3 mb-4">
                                    <h3 class="text-center" style="font-size: 25px; font-weight: bold;">
                                        ใบเบิกสินค้า / PICKING OPERATIONS
                                    </h3>
                                </div>

                                <!-- Header Information -->
                                <div class="row mt-3">
                                    <div class="col-6">
                                        <div class="info-box" style="height: 180px;">
                                            <div class="mb-2">
                                                <strong style="width: 35%; display: inline-block;">เลขที่เอกสาร:</strong>
                                                <span t-field="o.name"/>
                                            </div>
                                            <div class="mb-2">
                                                <strong style="width: 35%; display: inline-block;">เอกสารอ้างอิง:</strong>
                                                <span t-field="o.origin"/>
                                            </div>
                                            <div class="mb-2">
                                                <strong style="width: 35%; display: inline-block;">วันที่:</strong>
                                                <span t-field="o.scheduled_date"/>
                                            </div>
                                            <div class="mb-2">
                                                <strong style="width: 35%; display: inline-block;">ประเภทการดำเนินการ:</strong>
                                                <span t-field="o.picking_type_id"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="info-box" style="height: 180px;">
                                            <div class="mb-2">
                                                <strong style="width: 35%; display: inline-block;">ต้นทาง:</strong>
                                                <span t-field="o.location_id"/>
                                            </div>
                                            <div class="mb-2">
                                                <strong style="width: 35%; display: inline-block;">ปลายทาง:</strong>
                                                <span t-field="o.location_dest_id"/>
                                            </div>
                                            <div class="mb-2">
                                                <strong style="width: 35%; display: inline-block;">ผู้ควบคุม:</strong>
                                                <span t-field="o.supervisor_id"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Products Table -->
                                <div class="table-container">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr class="header-row">
                                                <th style="width: 5%; text-align: center;">ลำดับ</th>
                                                <th style="width: 10%;">รหัสสินค้า</th>
                                                <th style="width: 40%;">รายการสินค้า</th>
                                                <th style="width: 10%; text-align: center;">จำนวน</th>
                                                <th style="width: 15%; text-align: center;">Lot/Serial</th>
                                                <th style="width: 10%;">ตำแหน่งต้นทาง</th>
                                                <th style="width: 10%;">ตำแหน่งปลายทาง</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="chunk_start" t-value="page_index * 15"/>
                                            <t t-set="chunk_end" t-value="(page_index + 1) * 15"/>
                                            <t t-set="chunk_moves" t-value="o.move_ids[chunk_start:chunk_end]"/>
                                            
                                            <t t-foreach="chunk_moves" t-as="move">
                                                <tr class="data-row">
                                                    <td style="text-align: center;"><span t-esc="chunk_start + move_index + 1"/></td>
                                                    <td><div style="overflow: hidden; text-overflow: ellipsis;"><span t-field="move.product_id.default_code"/></div></td>
                                                    <td><div style="overflow: hidden; text-overflow: ellipsis;"><span t-field="move.product_id.name"/></div></td>
                                                    <td style="text-align: center;">
                                                        <div style="overflow: hidden; text-overflow: ellipsis;">
                                                            <span t-esc="'%.0f' % move.product_uom_qty"/>
                                                            <span t-field="move.product_uom.name"/>
                                                        </div>
                                                    </td>
                                                    <td style="text-align: center;"><div style="overflow: hidden; text-overflow: ellipsis;"><span t-field="move.lot_ids"/></div></td>
                                                    <td><div style="overflow: hidden; text-overflow: ellipsis;"><span t-field="move.location_id.name"/></div></td>
                                                    <td><div style="overflow: hidden; text-overflow: ellipsis;"><span t-field="move.location_dest_id.name"/></div></td>
                                                </tr>
                                            </t>
                                            
                                            <t t-foreach="range(max(0, 15 - len(chunk_moves)))" t-as="i">
                                                <tr class="empty-row">
                                                    <td></td><td></td><td></td><td></td><td></td><td></td><td></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Update the Totals Section -->
                                <div class="row mt-3">
                                    <div class="col-12">
                                        <div class="info-box">
                                            <div class="row">
                                                <div class="col-6">
                                                    <strong>Total Items / จำนวนรายการรวม: </strong>
                                                    <span t-esc="total_items"/> รายการ
                                                </div>
                                                <div class="col-6 text-right" style="text-align: right;">
                                                    <strong>Total Quantity / จำนวนชิ้นรวม: </strong>
                                                    <span t-esc="'%.0f' % total_qty"/> ชิ้น
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Signatures -->
                                <div class="row mt-5">
                                    <div class="col-3">
                                        <div class="text-center">
                                            <p style="border-top: 1px solid black; margin-top: 50px; font-size: 20px;">
                                                ผู้จัดทำ by
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="text-center">
                                            <p style="border-top: 1px solid black; margin-top: 50px; font-size: 20px;">
                                                ผู้ตรวจ by
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="text-center">
                                            <p style="border-top: 1px solid black; margin-top: 50px; font-size: 20px;">
                                                ผู้อนุมัติ by
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="text-center">
                                            <p style="border-top: 1px solid black; margin-top: 50px; font-size: 20px;">
                                                ผู้รับสินค้า by
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                </t>
            </t>
        </template>

        <!-- Report Action -->
        <record id="action_report_picking_operations_custom" model="ir.actions.report">
            <field name="name">ใบเบิกสินค้า / Picking Operations</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">buz_picking_operations.report_picking_operations_custom</field>
            <field name="report_file">buz_picking_operations.report_picking_operations_custom</field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="paperformat_id" ref="paperformat_picking_operations"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>